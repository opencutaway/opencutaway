{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opencutaway.github.io/schema/ui-title-screen.schema.json",
  "title": "Title-screen UI contract",
  "description": "Player-facing copy for the title screen. JSON Schema is the authority path; the child app must not invent a parallel parser.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "screenId",
    "title",
    "blurb",
    "actors",
    "lessonsShipped"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "0.1.0"
    },
    "screenId": {
      "type": "string",
      "const": "title"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "blurb": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "actors": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["child", "adult"]
      }
    },
    "lessonsShipped": {
      "type": "boolean",
      "const": false
    }
  }
}
