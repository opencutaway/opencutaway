{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opencutaway.github.io/schema/ui-title-screen.schema.json",
  "title": "Title-screen UI contract",
  "description": "Player-facing copy for the title screen. JSON Schema is the authority path; the child app must not invent a parallel parser.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "screenId",
    "title",
    "blurb",
    "actors",
    "learnControl",
    "lightsControl"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "0.3.0"
    },
    "screenId": {
      "type": "string",
      "const": "title"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "blurb": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "actors": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["child", "adult"]
      }
    },
    "learnControl": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "sittingId"],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "sittingId": {
          "type": "string",
          "const": "sitting-widen-1-get-across"
        }
      }
    },
    "lightsControl": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "sittingId"],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "sittingId": {
          "type": "string",
          "const": "sitting-widen-2-lights"
        }
      }
    }
  }
}
