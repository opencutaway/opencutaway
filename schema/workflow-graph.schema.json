{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opencutaway.github.io/schema/workflow-graph.schema.json",
  "title": "Build-time workflow graph",
  "description": "Declarative execution graph for Cursor/dev content work. Must not run inside the child-facing app.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "locus",
    "purpose",
    "cycleCap",
    "nodes",
    "edges"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "0.1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^wf-[a-z0-9-]+$",
      "maxLength": 64
    },
    "locus": {
      "type": "string",
      "const": "build-time"
    },
    "purpose": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "cycleCap": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "unattendedChildCopyLoops": {
      "type": "boolean",
      "const": false
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "summary"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$",
            "maxLength": 64
          },
          "kind": {
            "type": "string",
            "enum": ["task", "validate", "halt", "human-gate"]
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "roleId": {
            "type": "string",
            "pattern": "^ROLE-[A-Z0-9][A-Z0-9._-]*$"
          },
          "halt": {
            "type": "boolean"
          },
          "humanGate": {
            "type": "boolean"
          },
          "inputs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "outputs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": { "kind": { "const": "human-gate" } }
            },
            "then": {
              "required": ["humanGate"],
              "properties": {
                "humanGate": { "const": true },
                "halt": { "const": true }
              }
            }
          },
          {
            "if": {
              "properties": { "kind": { "const": "halt" } }
            },
            "then": {
              "required": ["halt"],
              "properties": {
                "halt": { "const": true }
              }
            }
          }
        ]
      }
    },
    "edges": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to", "handoff"],
        "properties": {
          "from": {
            "type": "string",
            "minLength": 1
          },
          "to": {
            "type": "string",
            "minLength": 1
          },
          "handoff": {
            "type": "string",
            "minLength": 1,
            "description": "File path or artifact name passed between nodes"
          }
        }
      }
    }
  }
}
