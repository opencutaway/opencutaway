{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opencutaway.github.io/schema/art-provenance.schema.json",
  "title": "Art provenance record",
  "description": "One record per shipped art, audio, or font asset (docs/art-bible.md, originality guardrails). Authors and reviewers are role IDs, never people (CLAUDE.md S7). Prompt text never enters the repository. The fileHash pins the asset bytes so a redraw must update its record.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "assetId",
    "file",
    "kind",
    "createdOn",
    "creator",
    "reviewer",
    "tools",
    "promptRecord",
    "references",
    "licence",
    "humanChanges",
    "technicalReview",
    "originalityReview",
    "fileHash"
  ],
  "properties": {
    "schemaVersion": { "type": "string", "const": "0.1.0" },
    "assetId": {
      "type": "string",
      "pattern": "^[A-Z0-9]+(_[A-Z0-9]+)+_v[0-9]{3}$",
      "maxLength": 80
    },
    "file": {
      "type": "string",
      "pattern": "^(src|content|public)/[A-Za-z0-9_-]+(/[A-Za-z0-9_.-]+)*\\.[a-z0-9]+$",
      "maxLength": 200
    },
    "kind": {
      "type": "string",
      "enum": ["svg-placeholder", "scene", "layer", "mask", "frames", "audio", "font"]
    },
    "createdOn": { "$ref": "#/$defs/isoDate" },
    "creator": { "$ref": "#/$defs/roleId" },
    "reviewer": { "$ref": "#/$defs/roleId" },
    "tools": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 120 }
    },
    "promptRecord": {
      "type": "string",
      "enum": ["none", "outside-repository"]
    },
    "references": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "items": { "$ref": "#/$defs/reference" }
    },
    "licence": { "$ref": "#/$defs/licence" },
    "humanChanges": { "type": "string", "maxLength": 1000 },
    "technicalReview": { "$ref": "#/$defs/review" },
    "originalityReview": { "$ref": "#/$defs/review" },
    "fileHash": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "hex"],
      "properties": {
        "algorithm": { "type": "string", "const": "sha256" },
        "hex": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  },
  "$defs": {
    "isoDate": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "roleId": { "type": "string", "pattern": "^ROLE-[A-Z-]+$", "maxLength": 40 },
    "licence": {
      "type": "string",
      "enum": ["MIT-clean", "CC0", "public-domain-us"]
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "note", "licence"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "none",
            "own-photo",
            "own-drawing",
            "public-document",
            "field-observation"
          ]
        },
        "note": { "type": "string", "minLength": 1, "maxLength": 300 },
        "licence": { "$ref": "#/$defs/licence" }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result", "record"],
      "properties": {
        "result": { "type": "string", "enum": ["pass", "fail", "pending"] },
        "record": { "type": "string", "minLength": 1, "maxLength": 300 }
      }
    }
  }
}
