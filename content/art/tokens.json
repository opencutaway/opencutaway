{
  "schemaVersion": "0.1.0",
  "source": {
    "title": "Infrastructure Game Visual Design Bible",
    "version": "1.2",
    "date": "2026-08-21",
    "owner": "docs/art-bible.md"
  },
  "projection": {
    "type": "dimetric-2-1",
    "groundDiamondPx": { "width": 64, "height": 32 },
    "axisDegrees": 26.565,
    "elevationUnitPx": 16,
    "halfElevationUnitPx": 8,
    "perspective": false,
    "cameraRotation": false,
    "mirroredScenes": false,
    "visibleFaces": ["lower-left", "lower-right"],
    "keyLight": "upper-left"
  },
  "canvas": {
    "logicalPx": { "width": 1024, "height": 768 },
    "exportScales": { "standard": 2, "permitted": 3 },
    "environmentScaling": "nearest-neighbour",
    "uiRendering": "native",
    "safeRegionPx": { "x": [112, 912], "y": [72, 696] }
  },
  "display": {
    "primary": "ipad-landscape",
    "supported": ["phone", "desktop"],
    "narrowScreens": "fit-width-then-pan",
    "pageScrollsSideways": false
  },
  "legacyPlaceholder": {
    "file": "src/app/renderers/BusyBlock.tsx",
    "viewBox": { "width": 960, "height": 540 },
    "tilePx": { "width": 72, "height": 36 },
    "minBlockWidthCssPx": 720,
    "status": "exempt-until-redrawn",
    "fault": "F-art-geometry-migration"
  },
  "objectScale": {
    "overview": { "frameWidthPct": [28, 42], "frameAreaPct": [24, 38] },
    "inspection": { "usableAreaPct": [58, 72], "usableAreaMaxPct": 78 },
    "quietBuffer": { "widthPct": 10, "severalTargetsWidthPct": 15 },
    "enlargementPct": {
      "principal": [125, 160],
      "smallComponent": [140, 200],
      "gapIncrease": [10, 30],
      "flowPathWiden": [15, 35]
    }
  },
  "zoom": {
    "transitionMs": [350, 500],
    "translationMaxFrameWidthPct": 25,
    "scale": [1.4, 2.2],
    "liftLogicalPx": [6, 12],
    "backgroundValueDropPoints": [8, 12],
    "backgroundSaturationDropPct": [20, 35]
  },
  "depthBands": {
    "foregroundMaxFramePct": 18,
    "middleGroundHighContrastEdgesPct": [60, 75]
  },
  "occlusion": {
    "overviewMaxSilhouettePct": 8,
    "neverCovers": [
      "tap-region",
      "named-component",
      "flow-endpoint",
      "safety-feature",
      "animation-result"
    ]
  },
  "pixel": {
    "exportBlockPx": 2,
    "clusterPx": [2, 4],
    "valueSteps": { "major": [4, 7], "minor": [2, 4] },
    "darkEdgeAccent": {
      "thicknessPx": 1,
      "maxPerimeterPct": 30,
      "uniformBlackOutline": false
    },
    "ditherBridgeMaxPx": 6,
    "antiAliasMaxPx": 1
  },
  "saturation": {
    "principalPct": 100,
    "immediateContextPct": [75, 90],
    "backgroundPct": [55, 75],
    "inspectionBackgroundPct": [45, 65],
    "processHighlightMaxPct": 115,
    "processHighlightScope": "active-path-only"
  },
  "lighting": {
    "key": { "direction": "upper-left", "temperature": "mildly-warm" },
    "fill": { "temperature": "cool", "character": "soft" },
    "weatherVariants": false,
    "timeOfDayVariants": false,
    "contactShadowPx": [1, 3],
    "smallObjectShadowPx": [4, 12]
  },
  "palette": {
    "anchors": [
      { "id": "deep-structural-shadow", "name": "Deep structural shadow", "hex": "#252B35", "role": "material" },
      { "id": "cool-shadow", "name": "Cool shadow", "hex": "#354253", "role": "material" },
      { "id": "asphalt", "name": "Asphalt", "hex": "#4B5963", "role": "material" },
      { "id": "dark-steel", "name": "Dark steel", "hex": "#56656B", "role": "material" },
      { "id": "galvanized-steel", "name": "Galvanized steel", "hex": "#87979A", "role": "material" },
      { "id": "warm-concrete", "name": "Warm concrete", "hex": "#AAA594", "role": "material" },
      { "id": "pale-concrete", "name": "Pale concrete", "hex": "#CAC5B3", "role": "material" },
      { "id": "weathered-wood", "name": "Weathered wood", "hex": "#8B654B", "role": "material" },
      { "id": "rust-accent", "name": "Rust accent", "hex": "#A65D3D", "role": "material" },
      { "id": "soil", "name": "Soil", "hex": "#7D654E", "role": "material" },
      { "id": "vegetation", "name": "Vegetation", "hex": "#65875B", "role": "material" },
      { "id": "deep-vegetation", "name": "Deep vegetation", "hex": "#405F49", "role": "material" },
      { "id": "water", "name": "Water", "hex": "#438EA1", "role": "material" },
      { "id": "deep-water", "name": "Deep water", "hex": "#315F77", "role": "material" },
      { "id": "safety-yellow", "name": "Safety yellow", "hex": "#E4B94E", "role": "material" },
      { "id": "signal-amber", "name": "Signal amber", "hex": "#E69A3B", "role": "light" },
      { "id": "signal-red", "name": "Signal red", "hex": "#D65352", "role": "light" },
      { "id": "signal-green", "name": "Signal green", "hex": "#4BA16B", "role": "light" },
      { "id": "instructional-cyan", "name": "Instructional cyan", "hex": "#6CCED0", "role": "instructional" },
      { "id": "electrical-violet", "name": "Electrical violet", "hex": "#8A7ED6", "role": "instructional" },
      { "id": "selection-gold", "name": "Selection gold", "hex": "#F5D26A", "role": "instructional" },
      { "id": "warm-light", "name": "Warm light", "hex": "#F0C685", "role": "light" },
      { "id": "soft-highlight", "name": "Soft highlight", "hex": "#EDE8DA", "role": "light" }
    ],
    "materialRamp": {
      "steps": [4, 7],
      "values": ["deep-shadow", "contact-or-seam", "base", "light-plane", "highlight"],
      "accentsMax": 2
    }
  },
  "processCoding": [
    {
      "process": "water",
      "colourFamily": "cyan-blue",
      "anchor": "instructional-cyan",
      "motion": "continuous band, droplets, or directional ripples",
      "pairedWithMotion": true,
      "colourAlone": false,
      "endsWithDemonstration": true
    },
    {
      "process": "electricity",
      "colourFamily": "violet",
      "anchor": "electrical-violet",
      "motion": "discrete pulsing dots or segmented glow",
      "pairedWithMotion": true,
      "colourAlone": false,
      "endsWithDemonstration": true
    },
    {
      "process": "mechanical-load",
      "colourFamily": "amber-gold",
      "anchor": "signal-amber",
      "motion": "sequential compression or transfer pulse",
      "pairedWithMotion": true,
      "colourAlone": false,
      "endsWithDemonstration": true
    },
    {
      "process": "data-control",
      "colourFamily": "pale-neutral",
      "anchor": "soft-highlight",
      "motion": "dashed pulse or brief node-to-node flash",
      "pairedWithMotion": true,
      "colourAlone": false,
      "endsWithDemonstration": true
    },
    {
      "process": "vehicle-pedestrian-path",
      "colourFamily": "muted-warm-white",
      "anchor": "warm-light",
      "motion": "moving footprints, wheel trace, or short path emphasis",
      "pairedWithMotion": true,
      "colourAlone": false,
      "endsWithDemonstration": true
    }
  ],
  "touch": {
    "minHitCssPx": 44,
    "minHitOwner": "CLAUDE.md S9",
    "preferredPrimaryCssPx": 56,
    "childControlHeightCssPx": [48, 64],
    "adjacentSeparationMinCssPx": 8,
    "invisiblePaddingBeyondSprite": true,
    "tooSmallParts": "tap-parent-then-expose-larger-targets-in-inspection"
  },
  "timing": {
    "unit": "ms",
    "tapAcknowledgement": [80, 140],
    "tapAcknowledgementBeginsWithin": 100,
    "selectionEffectMax": 450,
    "separationMs": [300, 450],
    "overviewToInspection": [350, 500],
    "inspectionSettle": [150, 250],
    "coverOrComponentOpening": [300, 700],
    "localProcess": [1500, 4000],
    "systemConnection": [2000, 6000],
    "return": [300, 500],
    "ambientLoop": [2000, 8000],
    "completionPause": [500, 900]
  },
  "animation": {
    "distinctFramesPerSecond": {
      "decorativeCharacter": [8, 12],
      "waterAndProcessFlow": [12, 18]
    },
    "interpolationAllowed": ["mechanical-rotation", "transitions"],
    "indicators": "discrete-timed-states",
    "ambientBudget": {
      "pedestriansOrWorkers": [0, 3],
      "movingVehicles": [0, 2],
      "animalGroups": [0, 1],
      "environmentalLoops": [2, 4],
      "secondaryAction": 1,
      "note": "Q3: this budget governs motion only. Drawn density stays as settled in docs/level-spine.md (occupational density, many jobs in one view): many drawn, few moving."
    }
  },
  "text": {
    "objectTitleWords": [1, 4],
    "componentLabelWords": [1, 3],
    "captionMaxWords": 18,
    "captionLineMaxChars": 55,
    "captionCssPx": [19, 22],
    "labelCssPx": [17, 20],
    "buttonCssPx": [18, 22],
    "contrastNormalMin": 4.5,
    "contrastLargeMin": 3,
    "captionsForAllNarration": true,
    "audioRequired": false,
    "reducedMotion": ["fades", "staged-reveals", "sequential-emphasis"]
  },
  "ui": {
    "stylesheet": "src/index.css",
    "pageBackground": "#f4f1ea",
    "ink": "#12202a",
    "focusRing": "#b8770a",
    "focusRingWidthCssPx": 4,
    "focusRingNote": "selection-gold darkened to hold 3:1 on the page background",
    "throughLineOutline": "#12202a",
    "quietOutline": "#8f8678",
    "foundOutline": "#2e7d4f",
    "controlFocusRing": "#1e6e8a",
    "controlFocusRingWidthCssPx": 3,
    "blockBorder": "#1a1424",
    "blockBackground": "#3e6e92",
    "quietNameInk": "#5e574d",
    "quietNameBackground": "#d9d3c8",
    "cardBackground": "#fffdf8"
  },
  "layers": [
    "BG_FAR",
    "BG_MID",
    "BG_NEAR",
    "GROUND_BASE",
    "GROUND_DETAIL",
    "GROUND_REMOVABLE",
    "OBJECT_BASE",
    "OBJECT_PART_[NAME]",
    "OBJECT_INTERIOR",
    "OBJECT_CUTAWAY",
    "SHADOW_STATIC",
    "SHADOW_DYNAMIC",
    "FX_SELECTION",
    "FX_FLOW",
    "FX_PROCESS",
    "FX_AMBIENT",
    "CHARACTERS",
    "FOREGROUND_OCCLUSION",
    "HITMASK_[NAME]",
    "LABEL_ANCHOR_[NAME]",
    "AUDIO_ANCHOR_[NAME]"
